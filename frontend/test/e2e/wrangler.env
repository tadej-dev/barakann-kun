# E2Eテスト専用のAPI環境変数
# 本番・開発では使わない固定値だけを置く（本物の秘密値は書かない）
# wrangler devの--env-fileで読み込み、api/.dev.varsの値は使わない

# Auth.jsのセッション署名に使うE2E専用の値
AUTH_SECRET=e2e-playwright-auth-secret

# アカウントIDのハッシュ化に使うE2E専用の値
ACCOUNT_ID_HASH_SECRET=e2e-playwright-account-id-hash-secret

# Viteの開発サーバー経由で認証するためのURL
AUTH_URL=http://localhost:5173

# 認証の詳細ログはE2Eでは出さない
AUTH_DEBUG=false

# モックGoogleサーバーが受け付ける任意のクライアント情報
GOOGLE_CLIENT_ID=e2e-google-client-id
GOOGLE_CLIENT_SECRET=e2e-google-client-secret

# モックGoogleサーバーの各エンドポイント（mock-google-server.ts が待ち受ける）
GOOGLE_AUTHORIZATION_ENDPOINT=http://127.0.0.1:8788/authorize
GOOGLE_TOKEN_ENDPOINT=http://127.0.0.1:8788/token
GOOGLE_USERINFO_ENDPOINT=http://127.0.0.1:8788/userinfo
