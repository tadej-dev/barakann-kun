# Auth.jsのセッション署名に使うランダムな値
# 例: openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret

# GoogleのアカウントIDをハッシュにして保存するための秘密鍵（AUTH_SECRETとは別の値にする）
# 一度決めたら変えない。変えると既存ユーザーがログイン後に別人として扱われる。
# 例: openssl rand -hex 32
ACCOUNT_ID_HASH_SECRET=replace-with-a-random-secret

# フロントエンドの開発サーバーを経由するローカルURL
AUTH_URL=http://localhost:5173

# OAuthコールバックの原因調査時だけtrueにする（通常はfalse）
AUTH_DEBUG=false

# Google Cloud Consoleで発行したOAuthクライアント情報
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
